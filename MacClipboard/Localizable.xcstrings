          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer supprime tout l'historique et tous les snippets, sans retour ; exportez d'abord les snippets importants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota elimina tutta la cronologia e gli snippet in modo definitivo; esporta prima gli snippet importanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての履歴とスニペットが削除され元に戻せません。重要なスニペットは先に書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기록과 스니펫이 삭제되며 복구되지 않습니다. 중요한 스니펫은 먼저 내보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
